{
    "name": "risecommerce/magento2-mcp-connector",
    "description": "Connect Magento 2 to Claude, ChatGPT and other AI agents over the Model Context Protocol (MCP): OAuth 2.1 and bearer auth, admin ACL, PII-redacted audit log, and tools for catalog, CMS, customers, orders, marketing, inventory, reports and tax.",
    "type": "magento2-module",
    "keywords": [
        "magento",
        "magento2",
        "magento2-module",
        "adobe-commerce",
        "mage-os",
        "mcp",
        "model-context-protocol",
        "ai",
        "llm",
        "claude",
        "chatgpt"
    ],
    "homepage": "https://risecommerce.com/magento/mcp-connector",
    "license": "MIT",
    "authors": [
        {
            "name": "Risecommerce",
            "email": "info@risecommerce.com",
            "homepage": "https://risecommerce.com"
        }
    ],
    "support": {
        "issues": "https://github.com/risecommerce/magento2-mcp-connector/issues",
        "source": "https://github.com/risecommerce/magento2-mcp-connector",
        "docs": "https://github.com/risecommerce/magento2-mcp-connector#readme"
    },
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "ext-mbstring": "*",
        "magento/framework": "^103.0",
        "opis/json-schema": "^2.4",
        "magento/module-admin-notification": "*",
        "magento/module-authorization": "*",
        "magento/module-backend": "*",
        "magento/module-bundle": "*",
        "magento/module-catalog": "*",
        "magento/module-catalog-inventory": "*",
        "magento/module-catalog-rule": "*",
        "magento/module-cms": "*",
        "magento/module-config": "*",
        "magento/module-configurable-product": "*",
        "magento/module-cron": "*",
        "magento/module-csp": "*",
        "magento/module-currency-symbol": "*",
        "magento/module-customer": "*",
        "magento/module-directory": "*",
        "magento/module-downloadable": "*",
        "magento/module-eav": "*",
        "magento/module-indexer": "*",
        "magento/module-newsletter": "*",
        "magento/module-quote": "*",
        "magento/module-reports": "*",
        "magento/module-review": "*",
        "magento/module-sales": "*",
        "magento/module-sales-rule": "*",
        "magento/module-search": "*",
        "magento/module-store": "*",
        "magento/module-tax": "*",
        "magento/module-ui": "*",
        "magento/module-user": "*"
    },
    "suggest": {
        "magento/module-inventory-api": "Required by Risecommerce_McpInventoryTools (Multi-Source Inventory)",
        "magento/module-inventory-catalog-api": "Required by Risecommerce_McpInventoryTools (Multi-Source Inventory)",
        "magento/module-inventory-configuration-api": "Required by Risecommerce_McpInventoryTools (Multi-Source Inventory)",
        "magento/module-inventory-reservations-api": "Required by Risecommerce_McpInventoryTools (Multi-Source Inventory)",
        "magento/module-inventory-sales-api": "Required by Risecommerce_McpInventoryTools (Multi-Source Inventory)"
    },
    "autoload": {
        "files": [
            "Mcp/registration.php",
            "McpInventoryTools/registration.php",
            "McpReportTools/registration.php",
            "McpTaxTools/registration.php",
            "PiiRedactor/registration.php"
        ],
        "psr-4": {
            "Risecommerce\\Mcp\\": "Mcp/",
            "Risecommerce\\McpInventoryTools\\": "McpInventoryTools/",
            "Risecommerce\\McpReportTools\\": "McpReportTools/",
            "Risecommerce\\McpTaxTools\\": "McpTaxTools/",
            "Risecommerce\\PiiRedactor\\": "PiiRedactor/"
        }
    }
}
