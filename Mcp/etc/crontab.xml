<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="risecommerce_mcp_audit_purge" instance="Risecommerce\Mcp\Cron\PurgeAuditLog" method="execute">
            <schedule>0 3 * * *</schedule>
        </job>
        <job name="risecommerce_mcp_purge_oauth" instance="Risecommerce\Mcp\Cron\PurgeOAuthCodes" method="execute">
            <schedule>0 4 * * *</schedule>
        </job>
        <job name="risecommerce_mcp_check_module_updates" instance="Risecommerce\Mcp\Cron\CheckModuleUpdates" method="execute">
            <schedule>0 5 * * *</schedule>
        </job>
    </group>
</config>
