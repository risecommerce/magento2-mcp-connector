<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Risecommerce_Mcp">
        <sequence>
            <module name="Risecommerce_PiiRedactor"/>
            <module name="Magento_User"/>
            <module name="Magento_Backend"/>
            <module name="Magento_Authorization"/>
            <module name="Magento_Store"/>
            <module name="Magento_Config"/>
            <module name="Magento_Indexer"/>
            <module name="Magento_Cron"/>
            <module name="Magento_AdminNotification"/>
            <module name="Magento_Csp"/>
            <!-- catalog, cms, customer, order and marketing tools -->
            <module name="Magento_Catalog"/>
            <module name="Magento_CatalogInventory"/>
            <module name="Magento_ConfigurableProduct"/>
            <module name="Magento_Bundle"/>
            <module name="Magento_Cms"/>
            <module name="Magento_Customer"/>
            <module name="Magento_Sales"/>
            <module name="Magento_CatalogRule"/>
            <module name="Magento_SalesRule"/>
        </sequence>
    </module>
</config>
