<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::system">
                    <resource id="Risecommerce_Mcp::mcp">
                        <resource id="Risecommerce_Mcp::tools">

                            <!-- Read tools -->
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_source_list"
                                      title="Tool: List Inventory Sources" sortOrder="100"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_source_get"
                                      title="Tool: Get Inventory Source" sortOrder="101"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_stock_list"
                                      title="Tool: List Stocks" sortOrder="110"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_stock_get"
                                      title="Tool: Get Stock" sortOrder="111"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_source_item_list"
                                      title="Tool: List Source Items" sortOrder="120"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_salable_qty_get"
                                      title="Tool: Get Salable Quantity" sortOrder="130"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_stock_item_configuration_get"
                                      title="Tool: Get Stock Item Configuration" sortOrder="140"/>

                            <!-- Write tools -->
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_source_create"
                                      title="Tool: Create Inventory Source" sortOrder="200"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_source_update"
                                      title="Tool: Update Inventory Source" sortOrder="201"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_stock_create"
                                      title="Tool: Create Stock" sortOrder="210"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_stock_update"
                                      title="Tool: Update Stock" sortOrder="211"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_stock_delete"
                                      title="Tool: Delete Stock" sortOrder="212"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_stock_assign_sources"
                                      title="Tool: Assign Sources To Stock" sortOrder="213"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_stock_unassign_sources"
                                      title="Tool: Unassign Sources From Stock" sortOrder="214"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_stock_set_sales_channels"
                                      title="Tool: Set Stock Sales Channels" sortOrder="215"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_source_item_set"
                                      title="Tool: Set Source Item Quantities" sortOrder="220"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_source_item_delete"
                                      title="Tool: Delete Source Items" sortOrder="221"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_stock_item_configuration_set"
                                      title="Tool: Set Stock Item Configuration" sortOrder="230"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_bulk_source_assign"
                                      title="Tool: Bulk Assign Sources" sortOrder="240"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_bulk_source_unassign"
                                      title="Tool: Bulk Unassign Sources" sortOrder="241"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_bulk_transfer"
                                      title="Tool: Bulk Transfer Inventory" sortOrder="242"/>
                            <resource id="Risecommerce_McpInventoryTools::tool_inventory_bulk_partial_transfer"
                                      title="Tool: Bulk Partial Transfer Inventory" sortOrder="243"/>

                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
